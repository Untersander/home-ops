          "refId": "A",
          "expr": "smartctl_device_attribute{job=\"smartctl-exporter\", instance=~\"$instance\", device=~\"$device\", attribute_value_type=\"raw\", attribute_id=\"199\"}",
          "range": true,
          "legendFormat": "{{device}} {{attribute_name}}"
