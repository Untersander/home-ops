          "refId": "A",
          "expr": "max by (instance, device) (smartctl_device_attribute{job=\"smartctl-exporter\", instance=~\"$instance\", device=~\"$device\", attribute_value_type=\"value\", attribute_name=~\"Wear_Leveling_Count|Media_Wearout_Indicator|SSD_Life_Left|Percent_Lifetime_Remain|Remaining_Lifetime_Perc\"}) or (100 - max by (instance, device) (smartctl_device_percentage_used{job=\"smartctl-exporter\", instance=~\"$instance\", device=~\"$device\"}))",
