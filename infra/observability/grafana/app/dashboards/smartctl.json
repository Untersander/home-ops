          },
          "refId": "D",
          "expr": "max by (instance, device, attribute_id, attribute_name, attribute_flags_short) (smartctl_device_attribute{job=\"smartctl-exporter\", instance=~\"$instance\", device=~\"$device\", attribute_value_type=\"raw\"})",
          "range": false,
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
