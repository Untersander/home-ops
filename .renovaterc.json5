{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    ':dependencyDashboard',
    ':semanticCommits',
    ':separateMajorReleases',
    ':timezone(Europe/Zurich)',
  ],
  baseBranchPatterns: [
    'main',
  ],
  enabledManagers: [
    'flux',
    'helm-values',
    'kubernetes',
    'custom.regex',
    'github-actions',
  ],
  ignorePaths: [
    '**/tmp/**',
    'infra/flux-system/crds.yaml',
  ],
  labels: [
    'dependencies',
    'renovate',
  ],
  prConcurrentLimit: 5,
  prHourlyLimit: 2,
  rangeStrategy: 'bump',
  packageRules: [
    {
      matchPackageNames: [
        'ghcr.io/siderolabs/kubelet',
        'ghcr.io/siderolabs/installer',
      ],
      groupName: 'system-upgrade',
    },
    {
      matchFileNames: [
        'infra/flux-system/gotk-components.yaml',
      ],
      matchManagers: [
        'kubernetes',
      ],
      enabled: false,
    },
    {
      matchManagers: [
        'flux',
      ],
      groupName: 'flux-sources-and-charts',
    },
    {
      matchManagers: [
        'kubernetes',
        'helm-values',
      ],
      matchUpdateTypes: [
        'digest',
      ],
      groupName: 'container-image-digests',
    },
    {
      matchUpdateTypes: [
        'major',
      ],
      automerge: false,
    },
  ],
  customManagers: [
    {
      customType: 'regex',
      description: 'Track OCIRepository tags used by Flux',
      managerFilePatterns: [
        '/(^|/)apps\\/.*\\/ocirepository\\.ya?ml$/',
        '/(^|/)infra\\/.*\\/ocirepository\\.ya?ml$/',
      ],
      matchStrings: [
        'kind:\\s*OCIRepository[\\s\\S]*?ref:\\s*[\\s\\S]*?tag:\\s*(?<currentValue>[^\\s]+)[\\s\\S]*?url:\\s*oci:\\/\\/(?<depName>[^\\s]+)',
      ],
      datasourceTemplate: 'docker',
    },
    {
      customType: 'regex',
      description: 'Track custom Tuppr upgrade versions via inline renovate annotations',
      managerFilePatterns: [
        '/infra\\/system-upgrade\\/tuppr\\/upgrades\\/.*\\.ya?ml$/',
      ],
      matchStrings: [
        'renovate:\\s*datasource=(?<datasource>[^\\s]+)\\s+depName=(?<depName>[^\\s]+)\\s*\\n\\s*version:\\s*(?<currentValue>[^\\s]+)',
      ],
    },
  ],
}
